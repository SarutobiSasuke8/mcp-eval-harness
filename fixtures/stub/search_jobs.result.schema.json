{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["query", "limit", "total", "jobs"],
  "properties": {
    "query": { "type": "string" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "total": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string" },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "company", "location", "remote", "tags"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "company": { "type": "string" },
          "location": { "type": "string" },
          "remote": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
